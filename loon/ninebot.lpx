#!name = 九号出行签到
#!desc = 获取授权信息并执行每日签到
#!author = fishyo
#!homepage = https://github.com/fishyo/someLoonThings

[Script]
http-request ^https://cn-cbu-gateway\.ninebot\.com/portal/api/user-sign/v(1|2)/sign script-path=https://raw.githubusercontent.com/fishyo/someLoonThings/refs/heads/refactor/cross-platform-scripts/scripts/ninebotCookie.js, requires-body=true, timeout=10, tag=九号出行获取凭据, enable=true
cron "0 8 * * *" script-path=https://raw.githubusercontent.com/fishyo/someLoonThings/refs/heads/refactor/cross-platform-scripts/scripts/ninebotSign.js, timeout=60, tag=九号出行签到, enable=true

[MITM]
hostname = cn-cbu-gateway.ninebot.com
