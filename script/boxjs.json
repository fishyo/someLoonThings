{
  "id": "fishyo",
  "name": "someLoonThings",
  "author": "@fishyo",
  "icon": "🖲️",
  "repo": "https://github.com/fishyo/someLoonThings",
  "apps": [
    {
      "id": "bandwagon",
      "name": "Bandwagon 服务器状态",
      "descs_html": [
        "查询 Bandwagon VPS 服务器状态、带宽使用情况",
        "支持实时查询带宽使用、IP地址、重置时间等信息"
      ],
      "keys": [
        "bandwagon.apiKey",
        "bandwagon.veid"
      ],
      "settings": [
        {
          "id": "bandwagon.apiKey",
          "name": "API Key",
          "val": "",
          "type": "text",
          "placeholder": "输入你的 Bandwagon API Key",
          "desc": "从 Bandwagon 面板获取的 API 密钥"
        },
        {
          "id": "bandwagon.veid",
          "name": "VEID",
          "val": "",
          "type": "text",
          "placeholder": "输入你的 VEID",
          "desc": "VPS 的唯一标识符"
        }
      ],
      "author": "@fishyo",
      "repo": "https://github.com/fishyo/someLoonThings",
      "script": "https://raw.githubusercontent.com/fishyo/someLoonThings/main/script/bandwagon/bwg.js",
      "icons": [
        "https://raw.githubusercontent.com/fishyo/someLoonThings/main/icons/bandwagon.png",
        "https://raw.githubusercontent.com/fishyo/someLoonThings/main/icons/bandwagon.png"
      ]
    },
    {
      "id": "racknerd",
      "name": "RackNerd 服务器状态",
      "descs_html": [
        "查询 RackNerd VPS 服务器状态、带宽使用情况",
        "支持实时查询带宽、内存、硬盘使用、IP地址等信息",
        "使用 RackNerd API 进行数据获取"
      ],
      "keys": [
        "racknerd.apiKey",
        "racknerd.apiHash"
      ],
      "settings": [
        {
          "id": "racknerd.apiKey",
          "name": "API Key",
          "val": "",
          "type": "text",
          "placeholder": "输入你的 API Key",
          "desc": "从 RackNerd 控制面板获取的 API Key"
        },
        {
          "id": "racknerd.apiHash",
          "name": "API Hash",
          "val": "",
          "type": "text",
          "placeholder": "输入你的 API Hash",
          "desc": "从 RackNerd 控制面板获取的 API Hash"
        }
      ],
      "author": "@fishyo",
      "repo": "https://github.com/fishyo/someLoonThings",
      "script": "https://raw.githubusercontent.com/fishyo/someLoonThings/main/script/racknerd/racknerd.js",
      "icons": [
        "https://raw.githubusercontent.com/fishyo/someLoonThings/main/icons/racknerd.png",
        "https://raw.githubusercontent.com/fishyo/someLoonThings/main/icons/racknerd.png"
      ]
    },
    {
      "id": "cloudflare",
      "name": "Cloudflare Workers 状态",
      "descs_html": [
        "定时查询 Cloudflare Workers 每日免费请求配额 (10万次/天)",
        "支持剩余请求、子请求与报错统计及阈值超限预警"
      ],
      "keys": [
        "cloudflare.accountTag",
        "cloudflare.apiToken",
        "cloudflare.alertThreshold"
      ],
      "settings": [
        {
          "id": "cloudflare.accountTag",
          "name": "Account ID",
          "val": "",
          "type": "text",
          "placeholder": "输入 32 位 Account ID",
          "desc": "Cloudflare 仪表盘右侧的 Account ID"
        },
        {
          "id": "cloudflare.apiToken",
          "name": "API Token",
          "val": "",
          "type": "text",
          "placeholder": "输入具备 Analytics:Read 的 API 令牌",
          "desc": "Cloudflare API 令牌"
        },
        {
          "id": "cloudflare.alertThreshold",
          "name": "预警阈值 (%)",
          "val": "80",
          "type": "text",
          "placeholder": "默认 80",
          "desc": "今日请求使用率超出此百分比时触发告警"
        }
      ],
      "author": "@fishyo",
      "repo": "https://github.com/fishyo/someLoonThings",
      "script": "https://raw.githubusercontent.com/fishyo/someLoonThings/main/script/cloudflare/cloudflare.js",
      "icons": [
        "https://raw.githubusercontent.com/fishyo/someLoonThings/main/icons/cloudflare.png",
        "https://raw.githubusercontent.com/fishyo/someLoonThings/main/icons/cloudflare.png"
      ]
    }
  ]
}
