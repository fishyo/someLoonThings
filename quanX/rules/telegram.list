# Title: Telegram Ruleset
# Maintainer: fishyo (https://github.com/fishyo/someLoonThings)

# Telegram
host-keyword, telegram, proxy
host-suffix, telegram.org, proxy
host-suffix, t.me, proxy
host-suffix, telegra.ph, proxy
host-suffix, telegram.me, proxy
host-suffix, tx.me, proxy
host-suffix, telegram.dog, proxy
