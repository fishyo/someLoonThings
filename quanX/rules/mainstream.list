# ==============================================================================
# Mainstream Proxy Blacklist Ruleset (Quantumult X Format)
# Maintainer: fishyo
# Homepage: https://github.com/fishyo/someLoonThings
# ==============================================================================

# ==============================================================================
# 主流高频代理黑名单规则源 (Mainstream Proxy Blacklist Source)
# 说明: 覆盖日常核心翻墙服务、公共人机验证、媒体流、品牌短链与关键配套依赖
# 编写规则: 纯域名自动识别为后缀，关键词写 keyword:xxx，精准域名写 exact:xxx
# ==============================================================================

# ================================================================
# 1. 基础服务、搜索引擎与公共人机验证 (Base, Search & Captcha)
# ================================================================
# 公共人机验证 (致命隐性依赖，防卡死)
host-suffix, recaptcha.net, proxy
host-suffix, hcaptcha.com, proxy
host-suffix, challenges.cloudflare.com, proxy

# Google 核心基础服务与账号体系
host-suffix, google.com, proxy
host-suffix, googleapis.com, proxy
host-suffix, gstatic.com, proxy
host-suffix, googleusercontent.com, proxy
host-suffix, googletagmanager.com, proxy
host-suffix, 1e100.net, proxy
host-suffix, ggpht.com, proxy
host-suffix, gmail.com, proxy
host-suffix, googlehosted.com, proxy

# Google 官方短链与品牌域名
host-suffix, g.co, proxy
host-suffix, goo.gl, proxy
host-suffix, withgoogle.com, proxy
host-suffix, googleblog.com, proxy

# 常见地区重定向
host-suffix, google.com.hk, proxy
host-suffix, google.co.jp, proxy
host-suffix, google.co.uk, proxy

# 独立隐私搜索与微软外区
host-suffix, duckduckgo.com, proxy
host-suffix, duck.com, proxy
host-suffix, ddg.gg, proxy
host-suffix, search.brave.com, proxy
host-suffix, startpage.com, proxy
host-suffix, copilot.microsoft.com, proxy
host-suffix, sydneystorageextension.blob.core.windows.net, proxy
host, edgeservices.bing.com, proxy


