# ==============================================================================
# Mainstream Proxy Blacklist Ruleset (Quantumult X Format)
# Maintainer: fishyo
# Homepage: https://github.com/fishyo/someLoonThings
# ==============================================================================

# ==============================================================================
# 主流高频代理黑名单规则源 (Mainstream Proxy Blacklist Source)
# 
# 结构设计原则:
# 1. 功能性域名集中归类 (人机验证、公共CDN、字体、短链、测速、支付)
# 2. 同一品牌/服务的关联域名紧密聚合 (主站、静态资产、媒体流、品牌短链、地区重定向)
# ==============================================================================


# ==============================================================================
# 第一部分：通用功能性基础设施与跨站依赖 (Cross-Site Functional Services)
# 说明: 任意第三方网站均可能引用的公共底层服务，防止页面卡死、排版崩坏或验证码不显示
# ==============================================================================

# --- 1.1 公共人机验证与反机器人防护 (CAPTCHA & Bot Detection) ---
# 痛点: 大量直连出海网站使用此类验证码，漏配会导致登录/提交按钮灰显卡死
host-suffix, recaptcha.net, proxy
host-suffix, hcaptcha.com, proxy
host-suffix, challenges.cloudflare.com, proxy

# --- 1.2 全球公共前端静态库 CDN (Public Web CDNs) ---
# 痛点: 海外技术博客与文档大量引用，漏配会导致 JS/CSS 加载失败
host-suffix, cdnjs.cloudflare.com, proxy
host-suffix, jsdelivr.net, proxy
host-suffix, unpkg.com, proxy

# --- 1.3 字体库与富媒体资源 (Fonts & Media Assets) ---
host-suffix, fonts.googleapis.com, proxy
host-suffix, fonts.gstatic.com, proxy
host-suffix, typekit.net, proxy
host-suffix, giphy.com, proxy

# --- 1.4 全球通用短网址解析 (Universal URL Shorteners) ---
# 痛点: 邮件或海外社媒中点击短链接直连超时
host-suffix, bit.ly, proxy
host-suffix, tinyurl.com, proxy
host-suffix, ow.ly, proxy
host-suffix, is.gd, proxy

# --- 1.5 跨国在线支付与结账网关 (Global Payments) ---
# 痛点: 购买海外服务、订阅 ChatGPT Plus 绑卡结账必备
host-suffix, stripe.com, proxy
host-suffix, stripe.network, proxy

# --- 1.6 网络诊断、测速与出口 IP 探测 (Network Diagnostics) ---
host-suffix, speedtest.net, proxy
host-suffix, ipinfo.io, proxy
host-suffix, ipapi.co, proxy
host-suffix, nxtrace.org, proxy


# ==============================================================================
# 第二部分：平台与品牌全家桶 (Platform & Brand Ecosystems)
# 说明: 同一品牌旗下的主站、API、媒体 CDN、静态资产、官方短链及地区重定向集中聚合
# ==============================================================================

# ------------------------------------------------------------------------------
# 2.1 Google 完整生态 (搜索、账号、服务中台、品牌短链、分区域名)
# ------------------------------------------------------------------------------
host-suffix, google.com, proxy
host-suffix, googleapis.com, proxy
host-suffix, gstatic.com, proxy
host-suffix, googleusercontent.com, proxy
host-suffix, googletagmanager.com, proxy
host-suffix, 1e100.net, proxy
host-suffix, ggpht.com, proxy
host-suffix, gmail.com, proxy
host-suffix, googlehosted.com, proxy
# Google 官方短链与品牌服务
host-suffix, g.co, proxy
host-suffix, goo.gl, proxy
host-suffix, withgoogle.com, proxy
host-suffix, googleblog.com, proxy
# 常见地区跳转与重定向
host-suffix, google.com.hk, proxy
host-suffix, google.co.jp, proxy
host-suffix, google.co.uk, proxy

