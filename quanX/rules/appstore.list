# ==============================================================================
# App Store Direct Ruleset (Quantumult X Format)
# Maintainer: fishyo
# Homepage: https://github.com/fishyo/someLoonThings
# ==============================================================================

# App Store & iTunes API
host-suffix, itunes.apple.com, direct
host-suffix, apps.apple.com, direct
host-suffix, appsto.re, direct

# App Store Media & CDN Downloads
host-suffix, mzstatic.com, direct
host-suffix, cdn-apple.com, direct
host-suffix, aaplimg.com, direct

# Apple CDN Scheduling
host-suffix, apple-dns.net, direct

# Specific App Download Endpoints
host-suffix, iosapps.itunes.apple.com, direct
host-suffix, osxapps.itunes.apple.com, direct

# Software & System Updates CDN
host-suffix, swcdn.apple.com, direct
host-suffix, updates-http.cdn-apple.com, direct
host-suffix, updates.cdn-apple.com, direct

# Apple Domestic China Endpoints
host-suffix, apple.com.cn, direct
host-suffix, icloud.com.cn, direct
