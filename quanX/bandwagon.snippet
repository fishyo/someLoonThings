# ==============================================================================
# 搬瓦工 (BandwagonHost) VPS 状态定时查询 (Quantumult X Snippet)
# Author: fishyo
# Homepage: https://github.com/fishyo/someLoonThings
# Icon: https://raw.githubusercontent.com/fishyo/someLoonThings/main/icons/bandwagon.png
#
# 【参数配置说明 - 支持两种方式】：
# 方式 1（推荐，最简便）：直接在下方 task 任务 URL 后追加 #veid=你的VEID&apiKey=你的APIKEY
#        脚本在首次执行后会自动持久化写入 Quantumult X 的本地 $prefs 存储中，长久有效！
# 方式 2：使用 BoxJS 订阅并配置（应用 ID: bandwagon）。
# ==============================================================================

[task_local]
# 每天 06:02 定时查询搬瓦工 VPS 流量与运行状态（请将下方的 123456 和 your_api_key 替换为你的真实配置）
2 6 * * * https://raw.githubusercontent.com/fishyo/someLoonThings/main/script/bandwagon/bwg.js#veid=123456&apiKey=your_api_key, tag=Bandwagon VPS 状态, img-url=https://raw.githubusercontent.com/fishyo/someLoonThings/main/icons/bandwagon.png, enabled=true
