#!name = Vercel 免费额度监控
#!desc = 定时查询 Vercel Hobby 免费计划 30天周期 Serverless 函数调用量 (100万次)、出站流量 (100GB) 与构建时长。支持在插件配置页直接填写 Token 及自定义执行时间，留空则自动读取 BoxJS。
#!author = fishyo
#!homepage = https://github.com/fishyo/someLoonThings
#!icon = https://raw.githubusercontent.com/fishyo/someLoonThings/refs/heads/main/icons/vercel.png
#!date = 2026-10-28

[Argument]
# 1. 查询任务总开关
enable = switch, true, type=boolean, tag=启用查询, desc=是否自动查询并推送额度用量

# 2. 定时查询时间
cronExp = input, "0 9 * * *", type=string, tag=查询时间, desc=标准 Cron 表达式（分 时 日 月 周），默认每天 09:00 推送

# 3. 告警阈值
alertThreshold = input, "80", type=string, tag=告警阈值(%), desc=调用量或流量使用百分比达到此值时通知呈预警状态（默认 80%）

# 4. Vercel 凭据配置（留空自动读取 BoxJS）
token = input, "", type=string, tag=Access Token, desc=Vercel 个人 Settings -> Tokens 中生成的 Access Token（留空读取 BoxJS）
teamId = input, "", type=string, tag=Team ID, desc=团队 ID（个人 Hobby 免费账号留空即可）

[Script]
cron ${cronExp} then script("https://raw.githubusercontent.com/fishyo/someLoonThings/main/script/vercel/vercel.js", {${token}, ${teamId}, ${alertThreshold}}) with enable=${enable}, tag="Vercel Status", timeout=60
