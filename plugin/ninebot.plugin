#!name = 九号出行
#!desc = 九号电动车自动签到与 Cookie 获取。首次使用或 Cookie 失效时，在插件详情中开启【九号获取Cookie】脚本，打开九号出行 App 签到页面即可自动捕获；捕获成功后建议关闭该脚本。
#!author = fishyo
#!homepage = https://github.com/fishyo/someLoonThings
#!icon = https://raw.githubusercontent.com/fishyo/someLoonThings/refs/heads/main/icons/Find_My.png
#!date = 2026-10-21

[Script]
# 获取 Cookie（捕获成功后建议禁用，避免重复触发）
http-request ^https:\/\/cn-cbu-gateway\.ninebot\.com\/portal\/api\/user-sign\/v(1|2)\/sign script-path = https://raw.githubusercontent.com/fishyo/someLoonThings/main/script/9bot/9bot_cookie.js, requires-body = true, tag = 九号获取Cookie, enable = false

# 定时签到（每天 06:20 执行）
cron "20 6 * * *" script-path = https://raw.githubusercontent.com/fishyo/someLoonThings/main/script/9bot/9botsign.js, tag = 🛵ninebot, timeout = 60

[Mitm]
hostname = cn-cbu-gateway.ninebot.com
