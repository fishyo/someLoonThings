#!name = 9bot
#!desc = 9bot 自动签到与 Cookie 获取。可在插件配置页开启/关闭签到任务及自定义签到时间；首次使用或 Cookie 失效时开启【获取Cookie】开关，打开 App 签到页面即可自动捕获。
#!author = fishyo
#!homepage = https://github.com/fishyo/someLoonThings
#!icon = https://raw.githubusercontent.com/fishyo/someLoonThings/refs/heads/main/icons/ninebot.png
#!date = 2026-10-21

[Argument]
# 1. 签到定时任务开关（默认开启）
enable_sign = switch, true, type=boolean, tag=启用签到, desc=定时签到任务总开关。关闭后将不再自动执行签到。

# 2. 签到时间输入框（支持在手机 Loon 界面直接修改）
cronExpression = input, "20 6 * * *", type=string, tag=签到执行时间, desc=标准 Cron 表达式（分 时 日 月 周），默认每天 06:20 执行

# 3. 获取 Cookie 开关（默认关闭，按需开启）
capture_cookie = switch, false, type=boolean, tag=获取Cookie, desc=捕获Cookie开关。获取成功后请关闭，避免频繁唤醒脚本。

[Script]
# 获取 Cookie：与 Argument 的 capture_cookie 开关实时联动
request if ${url} ~= /^https:\/\/cn-cbu-gateway\.ninebot\.com\/portal\/api\/user-sign\/v(1|2)\/sign/i then script("https://raw.githubusercontent.com/fishyo/someLoonThings/main/script/9bot/9bot_cookie.js") with enable=${capture_cookie}, requires_body=true, tag="9bot获取Cookie"

# 定时签到：通过 ${cronExpression} 动态控制执行时间，并通过 ${enable_sign} 控制启用状态
cron ${cronExpression} then script("https://raw.githubusercontent.com/fishyo/someLoonThings/main/script/9bot/9botsign.js") with enable=${enable_sign}, tag="🛵9bot", timeout=60

[Mitm]
hostname = cn-cbu-gateway.ninebot.com
